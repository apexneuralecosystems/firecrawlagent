# ============================================================================
# FireCrawl Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# === Required ===
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=change-me-to-a-random-64-char-string

# === Optional: LLM Model ===
# LLM_MODEL=openrouter/openai/gpt-4o-mini

# === Email (required for password reset) ===
SEND_GRID_API=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Firecrawl Agent

# === PayPal ===
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# === Frontend URLs ===
FRONTEND_BASE_URL=https://yourdomain.com
FRONTEND_RESET_URL=https://yourdomain.com/reset-password

# Production Configuration Example
ENV=production
ALLOWED_ORIGINS=https://firecrawlai.apexneural.cloud,https://api.firecrawlai.apexneural.cloud
PORT=3000
BACKEND_PORT=8000
LOG_LEVEL=INFO
